# Copy this file to .env and fill in real values.
# Never commit .env — it's already in .gitignore.

# PostgreSQL connection string (Neon). Get this from your Neon project dashboard.
# In Vercel, set the same variable name in Project Settings > Environment Variables.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value in production than in local dev.
AUTH_SECRET=""

# Seed credentials for the admin panel (used once by `npm run db:seed`).
# Change the password after the first login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Google Analytics measurement ID (leave empty to disable analytics).
NEXT_PUBLIC_GA_ID=""
